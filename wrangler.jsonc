{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppl-navlog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_VERSION": "v0.0.0-dev",
    "APP_COMMIT_SHA": "local"
  },
  "observability": {
    "enabled": true
  }
}
