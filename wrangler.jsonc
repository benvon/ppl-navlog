{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ppl-navlog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "services": [
    { "binding": "RUNWAY_PICKER_API", "service": "runway-picker-metar-api" }
  ],
  "vars": {
    "APP_VERSION": "v0.0.0-dev",
    "APP_COMMIT_SHA": "local"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "workers_dev": false,
      "routes": [{ "pattern": "navlog.benvon.dev", "custom_domain": true }],
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "services": [
        { "binding": "RUNWAY_PICKER_API", "service": "runway-picker-metar-api" }
      ],
      "ratelimits": [
        { "name": "API_RATE_LIMITER", "namespace_id": "90221001", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "APP_ENV": "development",
        "APP_VERSION": "v0.0.0-dev",
        "APP_COMMIT_SHA": "local"
      },
      "observability": { "enabled": true }
    }
  }
}
