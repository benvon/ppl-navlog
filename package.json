{
  "name": "ppl-navlog",
  "private": true,
  "type": "module",
  "description": "A VFR flight-planning log that makes each calculation visible.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names ui,worker --prefix name \"vite --host 0.0.0.0 --port 5173\" \"npm run dev:worker\"",
    "dev:worker": "npm run build && concurrently --kill-others-on-fail --names navlog,coordinator --prefix name \"wrangler dev --local --env development --var APP_ENV:local --port 8787 --config wrangler.jsonc\" \"npm run dev:coordinator\"",
    "dev:coordinator": "wrangler dev --local --env development --port 8788 --config wrangler.weather-coordinator.jsonc",
    "build": "vite build && node scripts/write-version-manifest.mjs && node scripts/verify-build-artifacts.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:audit": "node scripts/run-audit.mjs",
    "security": "npm run security:secrets && npm run lint:workflows && npm run security:audit",
    "ci": "npm run typecheck && npm run lint && npm run lint:boundaries && npm run test:coverage && npm run build && npm run security",
    "cf:typegen": "wrangler types --env-interface Env",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "weather:bindings": "node scripts/verify-weather-bindings.mjs wrangler.jsonc wrangler.weather-coordinator.jsonc",
    "weather:build": "node scripts/build-weather-coordinator.mjs",
    "weather:artifact": "node scripts/verify-weather-coordinator-artifact.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.1",
    "wrangler": "^4.38.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "7.29.1"
    }
  }
}
